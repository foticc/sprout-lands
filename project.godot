; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="sprout-lands"
run/main_scene="uid://l1dc6irwt48s"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ToolsManager="*res://classes/globals/tools_manager.gd"
InventoryManager="*res://classes/globals/inventory_manager.gd"
DayAndNightCycleManager="*res://classes/globals/day_and_night_cycle_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GameDialogueManager="*res://classes/globals/game_dialogue_manager.gd"
ToastManager="*res://classes/globals/toast_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[global_group]

navigation_polygon_source_geometry_group=""
player=""

